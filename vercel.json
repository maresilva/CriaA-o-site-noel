{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/solucoes/manual-do-verdadeiro-papai-noel",
      "destination": "/manual-do-verdadeiro-papai-noel"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
